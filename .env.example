# Optional server-only credentials. Leave blank for local practice.
# Use a Firebase Spark project with billing disabled. Never use NEXT_PUBLIC_ here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Copy private_key from the service account file, including BEGIN/END lines.
# Quote the value and preserve escaped \n characters; the server restores them.
FIREBASE_PRIVATE_KEY=

# Optional: classic demo settings and final survey link.
NEXT_PUBLIC_ROOM_ID=demo
NEXT_PUBLIC_HOST_CODE=HOST
NEXT_PUBLIC_SURVEY_URL=
