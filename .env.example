# Firebase (Firestore) keys. Without these the app runs in local mode,
# where only tabs in the same browser share a room.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional
NEXT_PUBLIC_ROOM_ID=demo
NEXT_PUBLIC_HOST_CODE=HOST
NEXT_PUBLIC_SURVEY_URL=
